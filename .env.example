# Copy to .env and adjust. Never commit .env.

# Application
APP_NAME="Notchs API"
# ENVIRONMENT: local | development | staging | production
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Database: shared Neon project (see docs/WORKPLAN.md §0)
# Copy both URLs from the Neon console (Connect -> Connection string); the real values are
# in the password manager. Check your settings with: python -m app.db.check
# Pooled URL (host has -pooler): used by the app at runtime.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct URL (same host without -pooler): used by Alembic for migrations.
MIGRATION_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Local Postgres instead: empty DATABASE_URL / MIGRATION_DATABASE_URL, DB_USE_POOLER=false,
# and fill in DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME (DB_SSL empty).
# public = main branch schema (CI migrates it). Use dev_<yourname> for your own work.
DB_SCHEMA=public
# Neon's -pooler host is PgBouncer in transaction mode
DB_USE_POOLER=true
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=240
DB_STATEMENT_TIMEOUT_MS=30000
DB_ECHO=false
