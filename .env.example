# Copy to .env and adjust. Never commit .env.

# Application
APP_NAME="Notchs API"
# ENVIRONMENT: local | development | staging | production
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Database: shared Neon project (rules: README, "Database")
# Get BOTH URLs from the team password manager. Do NOT copy them from the Neon console:
# the console gives the neondb_owner login, which must never be used by the app.
# Check your settings with: python -m app.db.check
# Pooled URL as notchs_app (host has -pooler): used by the app at runtime.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct URL as notchs_migrator (same host without -pooler): used by Alembic for migrations.
MIGRATION_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Local Postgres instead: empty DATABASE_URL / MIGRATION_DATABASE_URL, DB_USE_POOLER=false,
# and fill in DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME (DB_SSL empty).
# CHANGE THIS to dev_<yourname> (lowercase, e.g. dev_harsh). public = development branch
# schema, migrated by CI only.
DB_SCHEMA=public
# Neon's -pooler host is PgBouncer in transaction mode
DB_USE_POOLER=true
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=240
DB_STATEMENT_TIMEOUT_MS=30000
DB_ECHO=false

# Redis: your own, started by docker compose (README, "Redis"). `redis` is the
# compose service name; outside Docker use redis://localhost:6379/0.
REDIS_URL=redis://redis:6379/0

# Auth. Locally the built-in development secret is used; staging and production refuse to
# start without a real one (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Encrypts counter phones' TOTP secrets. Locally a built-in development key is used; staging and
# production refuse to start without a real one. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOTP_ENCRYPTION_KEY=

# Email (Resend). true = nothing is sent, emails (with their codes and links) go to the log.
EMAIL_DRY_RUN=true
# RESEND_API_KEY=
# See emails in Mailpit (http://localhost:8025) instead: EMAIL_DRY_RUN=false and
# SMTP_HOST=mailpit. Local and development only.
# SMTP_HOST=mailpit
# SMTP_PORT=1025
EMAIL_FROM="Notchs <no-reply@notchs.com>"

# Where emailed links point (e.g. the venue app's /set-password page). https:// outside local.
VENUE_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
# An admin made at startup when there's no shell for `create-admin` (README, "An admin without a shell").
# FIRST_ADMIN_EMAIL=
# FIRST_ADMIN_NAME=
# FIRST_ADMIN_PASSWORD=
CUSTOMER_APP_URL=http://localhost:3002
# Optional: who gets a "New venue application" email (e.g. the team inbox). Empty = nobody.
# ADMIN_NOTIFY_EMAIL=

# WhatsApp Cloud API (Meta). true = nothing is sent, replies are written to the log (no Meta
# account needed). Production must use false, with the phone number ID and a token from Meta.
WHATSAPP_DRY_RUN=true
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Webhook: Meta signs every call with the app secret (Meta app -> App settings -> Basic).
# The verify token is any random string, also typed into Meta's "Configure Webhooks" form.
# Without the app secret every webhook call is refused.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# The number customers message (digits with country code). Counter phones put it in their QR.
# WHATSAPP_PUBLIC_NUMBER=15556755530
# Public https image sent with a stamp. Unset = the stamp is a text message.
# WHATSAPP_STAMP_IMAGE_URL=
# Seconds between checks for incoming messages left unhandled (e.g. by a restart). 0 = off.
WHATSAPP_SWEEP_INTERVAL_SECONDS=60
# Seconds between rebuilding leaderboards from the points ledger (and at startup). 0 = off.
LEADERBOARD_REBUILD_INTERVAL_SECONDS=3600

# Cloudflare Turnstile (CAPTCHA). true skips the check: local work only.
TURNSTILE_DISABLED=true
# TURNSTILE_SECRET=

# Protection (README, "Protection on every request"). 0 turns the global limit off.
# GLOBAL_RATE_LIMIT_PER_MINUTE=600
# MAX_REQUEST_BODY_BYTES=1000000
# The same value as the website's API_PROXY_SECRET, so visitors' addresses can't be made up.
# PROXY_SECRET=
